<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!--
            mcp/sdk's ToolInputSchema declares `properties` as array<string, mixed>,
            yet the SDK itself stores a \stdClass there (Tool::normalizeSchemaProperties,
            SchemaGenerator) so that an argument-less tool serializes as {} and not [].
            The OpenAPI bridge builds Tool directly, so it must normalize explicitly —
            psalm flags that correct value against the SDK's own inaccurate docblock.
            Scoped to the one constructor; revisit when the pin moves off ~0.6.0.
        -->
        <ArgumentTypeCoercion>
            <errorLevel type="suppress">
                <referencedFunction name="Mcp\Schema\Tool::__construct"/>
            </errorLevel>
        </ArgumentTypeCoercion>
    </issueHandlers>
</psalm>
