<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <!--
        Not a suppression: the stub CORRECTS mcp/sdk's inaccurate docblock.
        ToolInputSchema declares `properties` as array<string, mixed>, yet the
        SDK itself stores a \stdClass there (Tool::normalizeSchemaProperties,
        SchemaGenerator) so an argument-less tool serializes as {} and not [].
        The OpenAPI bridge builds Tool directly and must pass exactly that
        value; the stub makes the accepted type honest. Revisit whenever the
        SDK pin moves.
    -->
    <stubs>
        <file name="stubs/Tool.phpstub"/>
    </stubs>
</psalm>
